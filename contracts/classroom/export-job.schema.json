{
  "$defs": {
    "ExportFormat": {
      "enum": [
        "classroom_zip",
        "pptx",
        "offline_html",
        "mp4"
      ],
      "title": "ExportFormat",
      "type": "string"
    },
    "ExportJobPhase": {
      "enum": [
        "queued",
        "exporting",
        "validating",
        "materializing",
        "completed"
      ],
      "title": "ExportJobPhase",
      "type": "string"
    },
    "ExportJobStatus": {
      "enum": [
        "created",
        "quota_reserved",
        "queued",
        "exporting",
        "validating",
        "materializing",
        "succeeded",
        "failed",
        "canceled"
      ],
      "title": "ExportJobStatus",
      "type": "string"
    },
    "JobError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "JobError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "format": {
      "$ref": "#/$defs/ExportFormat"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_classroom_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Classroom Document Sha256",
      "type": "string"
    },
    "input_media_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Media Manifest Sha256",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "output_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "phase": {
      "$ref": "#/$defs/ExportJobPhase"
    },
    "progress_percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress Percent",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExportJobStatus"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "job_id",
    "idempotency_key",
    "status",
    "phase",
    "format",
    "attempt",
    "progress_percent",
    "input_classroom_document_sha256",
    "input_media_manifest_sha256",
    "created_at",
    "updated_at"
  ],
  "title": "ExportJob",
  "type": "object"
}

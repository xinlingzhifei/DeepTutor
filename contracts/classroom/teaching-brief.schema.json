{
  "$comment": "Draft 2020-12 enforces non-empty source structures for source_grounded. SourceFragment fragmentId, SourceCitation citationId, and SourceReference triple uniqueness plus cross-array lineage require semantic validation against permissionSummary allowlists.",
  "$defs": {
    "AssessmentPlan": {
      "additionalProperties": false,
      "properties": {
        "methods": {
          "items": {
            "enum": [
              "quiz",
              "discussion",
              "project",
              "observation",
              "self_assessment"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "successCriteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Successcriteria",
          "type": "array"
        }
      },
      "required": [
        "methods",
        "successCriteria"
      ],
      "title": "AssessmentPlan",
      "type": "object"
    },
    "KnowledgePoint": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "knowledgePointId": {
          "minLength": 1,
          "title": "Knowledgepointid",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "knowledgePointId",
        "title",
        "description"
      ],
      "title": "KnowledgePoint",
      "type": "object"
    },
    "KnowledgePrerequisite": {
      "additionalProperties": false,
      "properties": {
        "knowledgePointId": {
          "minLength": 1,
          "title": "Knowledgepointid",
          "type": "string"
        },
        "prerequisiteKnowledgePointIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Prerequisiteknowledgepointids",
          "type": "array"
        }
      },
      "required": [
        "knowledgePointId",
        "prerequisiteKnowledgePointIds"
      ],
      "title": "KnowledgePrerequisite",
      "type": "object"
    },
    "MediaPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowGeneration": {
          "title": "Allowgeneration",
          "type": "boolean"
        },
        "allowedMimeTypes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowedmimetypes",
          "type": "array"
        }
      },
      "required": [
        "allowGeneration",
        "allowedMimeTypes"
      ],
      "title": "MediaPolicy",
      "type": "object"
    },
    "NetworkPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowWebAccess": {
          "title": "Allowwebaccess",
          "type": "boolean"
        },
        "allowedDomains": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Alloweddomains",
          "type": "array"
        }
      },
      "required": [
        "allowWebAccess",
        "allowedDomains"
      ],
      "title": "NetworkPolicy",
      "type": "object"
    },
    "PermissionSummary": {
      "additionalProperties": false,
      "properties": {
        "allowedFragmentIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowedfragmentids",
          "type": "array"
        },
        "allowedSourceIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowedsourceids",
          "type": "array"
        },
        "attributionRequired": {
          "title": "Attributionrequired",
          "type": "boolean"
        },
        "usageScope": {
          "minLength": 1,
          "title": "Usagescope",
          "type": "string"
        }
      },
      "required": [
        "allowedSourceIds",
        "allowedFragmentIds",
        "usageScope",
        "attributionRequired"
      ],
      "title": "PermissionSummary",
      "type": "object"
    },
    "SafetyPolicy": {
      "additionalProperties": false,
      "properties": {
        "blockedCategories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Blockedcategories",
          "type": "array"
        },
        "policyId": {
          "minLength": 1,
          "title": "Policyid",
          "type": "string"
        }
      },
      "required": [
        "policyId",
        "blockedCategories"
      ],
      "title": "SafetyPolicy",
      "type": "object"
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "citationId": {
          "minLength": 1,
          "title": "Citationid",
          "type": "string"
        },
        "fragmentId": {
          "minLength": 1,
          "title": "Fragmentid",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        }
      },
      "required": [
        "citationId",
        "sourceId",
        "fragmentId",
        "label"
      ],
      "title": "SourceCitation",
      "type": "object"
    },
    "SourceFragment": {
      "additionalProperties": false,
      "properties": {
        "contentSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contentsha256",
          "type": "string"
        },
        "fragmentId": {
          "minLength": 1,
          "title": "Fragmentid",
          "type": "string"
        },
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "fragmentId",
        "sourceId",
        "text",
        "contentSha256"
      ],
      "title": "SourceFragment",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "citationId": {
          "minLength": 1,
          "title": "Citationid",
          "type": "string"
        },
        "fragmentId": {
          "minLength": 1,
          "title": "Fragmentid",
          "type": "string"
        },
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        }
      },
      "required": [
        "citationId",
        "sourceId",
        "fragmentId"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "contentSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contentsha256",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "snapshotId": {
          "minLength": 1,
          "title": "Snapshotid",
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "createdAt",
        "contentSha256"
      ],
      "title": "SourceSnapshot",
      "type": "object"
    },
    "TeachingObjective": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "knowledgePointIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Knowledgepointids",
          "type": "array"
        },
        "objectiveId": {
          "minLength": 1,
          "title": "Objectiveid",
          "type": "string"
        }
      },
      "required": [
        "objectiveId",
        "description",
        "knowledgePointIds"
      ],
      "title": "TeachingObjective",
      "type": "object"
    },
    "TemplatePolicy": {
      "additionalProperties": false,
      "properties": {
        "templateId": {
          "minLength": 1,
          "title": "Templateid",
          "type": "string"
        },
        "templateVersion": {
          "minLength": 1,
          "title": "Templateversion",
          "type": "string"
        }
      },
      "required": [
        "templateId",
        "templateVersion"
      ],
      "title": "TemplatePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contentMode": {
            "const": "source_grounded"
          }
        },
        "required": [
          "contentMode"
        ]
      },
      "then": {
        "properties": {
          "citations": {
            "minItems": 1
          },
          "permissionSummary": {
            "properties": {
              "allowedFragmentIds": {
                "minItems": 1,
                "uniqueItems": true
              },
              "allowedSourceIds": {
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "sourceFragments": {
            "minItems": 1
          },
          "sourceRefs": {
            "minItems": 1
          },
          "sourceSnapshot": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "assessment": {
      "$ref": "#/$defs/AssessmentPlan"
    },
    "audienceLevel": {
      "minLength": 1,
      "title": "Audiencelevel",
      "type": "string"
    },
    "briefId": {
      "minLength": 1,
      "title": "Briefid",
      "type": "string"
    },
    "briefVersion": {
      "minimum": 1,
      "title": "Briefversion",
      "type": "integer"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/SourceCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "classroomMode": {
      "enum": [
        "micro",
        "full"
      ],
      "title": "Classroommode",
      "type": "string"
    },
    "contentMode": {
      "enum": [
        "source_grounded",
        "open_creation"
      ],
      "title": "Contentmode",
      "type": "string"
    },
    "contentSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contentsha256",
      "type": "string"
    },
    "courseId": {
      "minLength": 1,
      "title": "Courseid",
      "type": "string"
    },
    "durationMinutes": {
      "minimum": 1,
      "title": "Durationminutes",
      "type": "integer"
    },
    "gradeBand": {
      "minLength": 1,
      "title": "Gradeband",
      "type": "string"
    },
    "knowledgePoints": {
      "items": {
        "$ref": "#/$defs/KnowledgePoint"
      },
      "minItems": 1,
      "title": "Knowledgepoints",
      "type": "array"
    },
    "mediaPolicy": {
      "$ref": "#/$defs/MediaPolicy"
    },
    "networkPolicy": {
      "$ref": "#/$defs/NetworkPolicy"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/TeachingObjective"
      },
      "minItems": 1,
      "title": "Objectives",
      "type": "array"
    },
    "permissionSummary": {
      "$ref": "#/$defs/PermissionSummary"
    },
    "prerequisites": {
      "items": {
        "$ref": "#/$defs/KnowledgePrerequisite"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "safetyPolicy": {
      "$ref": "#/$defs/SafetyPolicy"
    },
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceFragments": {
      "items": {
        "$ref": "#/$defs/SourceFragment"
      },
      "title": "Sourcefragments",
      "type": "array"
    },
    "sourceRefs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sourcerefs",
      "type": "array"
    },
    "sourceSnapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetClassId": {
      "minLength": 1,
      "title": "Targetclassid",
      "type": "string"
    },
    "templatePolicy": {
      "$ref": "#/$defs/TemplatePolicy"
    },
    "tenantId": {
      "minLength": 1,
      "title": "Tenantid",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "briefId",
    "briefVersion",
    "tenantId",
    "courseId",
    "targetClassId",
    "gradeBand",
    "audienceLevel",
    "classroomMode",
    "objectives",
    "durationMinutes",
    "knowledgePoints",
    "prerequisites",
    "assessment",
    "sourceSnapshot",
    "sourceFragments",
    "citations",
    "sourceRefs",
    "permissionSummary",
    "contentMode",
    "networkPolicy",
    "mediaPolicy",
    "templatePolicy",
    "safetyPolicy",
    "contentSha256"
  ],
  "title": "TeachingBrief",
  "type": "object"
}

  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "confirmedOutline"
                ]
              },
              {
                "required": [
                  "confirmedOutlineSha256"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "confirmedOutline": {
              "type": "null"
            },
            "confirmedOutlineSha256": {
              "type": "null"
            }
          },
          "required": [
            "confirmedOutline",
            "confirmedOutlineSha256"
          ]
        },
        {
          "properties": {
            "confirmedOutline": {
              "not": {
                "type": "null"
              }
            },
            "confirmedOutlineSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "confirmedOutline",
            "confirmedOutlineSha256"
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "content"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "confirmedOutline": {
            "not": {
              "type": "null"
            }
          },
          "confirmedOutlineSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "confirmedOutline",
          "confirmedOutlineSha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "content"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "confirmedOutline": {
            "properties": {
              "confirmationMetadata": {
                "properties": {
                  "status": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "classroomMode": {
              "const": "micro"
            },
            "phase": {
              "const": "micro"
            }
          },
          "required": [
            "phase",
            "classroomMode"
          ]
        },
        {
          "properties": {
            "classroomMode": {
              "const": "full"
            },
            "phase": {
              "enum": [
                "outline",
                "content"
              ]
            }
          },
          "required": [
            "phase",
            "classroomMode"
          ]
        }
      ]
    }
  ],
  "properties": {
    "callbackContext": {
      "minLength": 1,
      "pattern": "^[^:\\s]+$",
      "title": "Callbackcontext",
      "type": "string"
    },
    "classroomMode": {
      "enum": [
        "micro",
        "full"
      ],
      "title": "Classroommode",
      "type": "string"
    },
    "confirmedOutline": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutlineBundle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confirmedOutlineSha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SHA-256 of the canonical UTF-8 JSON serialization of the entire confirmed OutlineBundle.",
      "title": "Confirmedoutlinesha256"
    },
    "dataPlaneRouteId": {
      "description": "opaque control-plane routing key resolved by server configuration; not a provider identifier, secret, URL, or client-selectable model route.",
      "minLength": 1,
      "pattern": "^[^:\\s]+$",
      "title": "Dataplanerouteid",
      "type": "string"
    },
    "durationMinutes": {
      "minimum": 1,
      "title": "Durationminutes",
      "type": "integer"
    },

# Install only after replacing the example hostname and provisioning its TLS files.
# This is a dedicated virtual host, not the shared server's default site.
map $http_upgrade $yfeistai_shared_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name yfeistai.example.invalid;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name yfeistai.example.invalid;
    ssl_certificate /etc/yfeistai/tls/fullchain.pem;
    ssl_certificate_key /etc/yfeistai/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;

    location / {
        proxy_pass https://127.0.0.1:13783;
        proxy_ssl_server_name on;
        proxy_ssl_name yfeistai.example.invalid;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $yfeistai_shared_connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
